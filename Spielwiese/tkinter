import tkinter as tk
import json

# Load data from JSON files
with open(r"json\locations.json") as fd:
    locations = json.load(fd)
in_front_of_home = locations['Grauholz']['Vor deinem Zuhause']

with open(r"json\characters.json") as fd:
    characters = json.load(fd)
daisy = characters["friends"]["Daisy"]

# Create a function to append text to the game output Text widget
def append_to_game_output(text):
    game_text.insert("end", text + "\n")
    game_text.see("end")  # Auto-scroll to the end

# Define your game functions and logic
def start_game():
    append_to_game_output(f"{daisy['name']} erwacht aus ihrem Versteck und sieht eine Blutspur vor sich.")
    append_to_game_output("Möchtest du der Blutspur folgen oder das Haus verlassen?")

    choice_frame = tk.Frame(main_menu_window)
    choice_frame.pack()

    follow_blood_button = tk.Button(choice_frame, text="Blutspur folgen", command=follow_blood)
    leave_house_button = tk.Button(choice_frame, text="Haus verlassen", command=leave_house)

    follow_blood_button.pack(side="left")
    leave_house_button.pack(side="right")

def follow_blood():
    append_to_game_output("Das willst du nicht sehen, gehe lieber nach draußen.")
    daisy['location'] = in_front_of_home

def leave_house():
    append_to_game_output("Du gehst nach draußen.")
    daisy['location'] = in_front_of_home

def load_game_from_input(filename):
    if filename.lower() == "zurück":
        main_menu()
    else:
        # Load the game here
        append_to_game_output("Game loaded!")

# Define the main game window
main_menu_window = tk.Tk()
main_menu_window.title("Main Menu")

# Create a frame to hold both the game output and buttons
game_frame = tk.Frame(main_menu_window)
game_frame.pack()

# Create a separate window for the game output
game_text = tk.Text(game_frame, wrap=tk.WORD)
game_text.pack(side="left")

# Create buttons in the same frame
new_game_button = tk.Button(game_frame, text="New Game", command=start_game)
load_game_button = tk.Button(game_frame, text="Load Game", command=load_game_from_input)
exit_button = tk.Button(main_menu_window, text="Exit", command=main_menu_window.quit)

new_game_button.pack(side="left")
load_game_button.pack(side="left")
exit_button.pack()

# Start the main menu
main_menu_window.mainloop()
